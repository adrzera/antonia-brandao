---

<Layout>
  <a class="skip" href="#conteudo">Pular para o conteúdo</a>

  <header class="site-header">
    <div class="wrap header-inner">
      <a class="logo" href="#topo" aria-label="Antônia Brandão — página inicial">
        <img src="/img/flourish-gold-177.webp" alt="" width="37" height="46" />
        <img
          class="logo-word"
          src="/img/logo.svg"
          alt="Antônia Brandão"
          width="188"
          height="40"
        />
      </a>
      <!-- <details> dá o menu sanfona no mobile sem uma linha de JS -->
      <details class="menu">
        <summary aria-label="Abrir menu">
          <span class="burger" aria-hidden="true"></span>
        </summary>
        <nav aria-label="Principal">
          <a href="#atendimento">Atendimento</a>
          <a href="#sobre">Sobre</a>
          <a href="#contato">Contato</a>
        </nav>
      </details>
    </div>
  </header>

  <main id="conteudo">
    <!-- ── Hero ───────────────────────────────────────────── -->
    <section class="hero" id="topo">
      <div class="hero-stage">
      {/* desktop: foto sem botões (botões vêm em HTML por cima).
          mobile: foto com os botões já embutidos na imagem. */}
