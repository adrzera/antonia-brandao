        <source
          media="(max-width: 899px)"
          srcset="/img/hero-mobile-587.webp 587w, /img/hero-mobile-1174.webp 1174w"
          sizes="100vw"
          width="587"
          height="629"
        />
        <img
          class="hero-scene"
          src="/img/hero-1440.webp"
          srcset="/img/hero-800.webp 800w, /img/hero-1440.webp 1440w, /img/hero-2160.webp 2160w"
          sizes="100vw"
          alt="Antônia Brandão sentada em uma poltrona, em um estúdio de paredes claras"
          width="1440"
          height="760"
          fetchpriority="high"
          decoding="async"
        />
      </picture>

      {/* no mobile, torna clicáveis os botões desenhados na imagem */}
      <a
        class="hero-tap"
        href={whatsapp}
        rel="noopener"
        aria-label="Agendar minha sessão pelo WhatsApp"></a>

      <div class="wrap hero-inner">
        <h1 class="hero-title">
          <em>Você</em> não<br />precisa <em>carregar</em><br />isso sozinho.
        </h1>

        <div class="hero-actions">
          <a class="btn btn-glass" href={whatsapp} rel="noopener">
            Agendar minha 1ª sessão
          </a>
          <a class="btn btn-glass" href={whatsapp} rel="noopener">
            Quero conversar antes
          </a>
        </div>
        <p class="hero-meta">Psicóloga · CRP 06/116557 · São Paulo</p>
      </div>
      </div>

      <p class="wrap hero-note">
        A terapia não é para quem está <span class="u">“quebrado”</span>.<br /><br
        />É para quem já percebeu que algo pode mudar e quer entender por onde
        começar.
      </p>
    </section>

    <!-- ── Prova social ───────────────────────────────────── -->
    <section class="reveal stats" aria-labelledby="stats-title">
      <img
        class="stats-bg"
        src="/img/stats-bg-1400.webp"
        srcset="/img/stats-bg-700.webp 700w, /img/stats-bg-1400.webp 1400w"
        sizes="(min-width: 1440px) 1400px, 100vw"
        alt=""
        width="1400"
        height="624"
        loading="lazy"
        decoding="async"
      />
      <div class="wrap">
        <img
          class="stats-flourish"
          src="/img/flourish-gold-177.webp"
          alt=""
          width="110"
          height="137"
          loading="lazy"
        />
        <p class="stats-number" id="stats-title">100+</p>
        <p class="stats-sub">
          clientes atendidos nos últimos anos. Com histórias reais de
          transformação
        </p>

        <ul class="testimonials">
          {
            testimonials.map((t) => (
              <li>
                <blockquote>
                  <p>“{t.quote}”</p>
                  <footer>{t.author}</footer>
