            Antes de marcar,<br />veja as respostas<br />mais comuns.
          </h2>
        </div>
        <div class="faq-list">
          {
            faq.map((item, i) => (
              <details open={i === 0}>
                <summary>
                  {item.q}
                  <svg
                    class="chevron"
                    viewBox="0 0 14 8"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path
                      d="M1 1l6 6 6-6"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.2"
                    />
                  </svg>
                </summary>
                <p>{item.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ── Chamada final ──────────────────────────────────── -->
    <section class="reveal final-cta">
      <div class="wrap">
        <h2 class="section-title final-title">
          O primeiro passo é o mais difícil.<br />E também o mais importante.
        </h2>
        <p class="final-note">
          Se você chegou até aqui, algo dentro de você já está pronto para
          mudar. Vamos conversar?
        </p>
        {/* botão como imagem; o alt dá o nome acessível ao link */}
        <a class="btn-img" href={whatsapp} rel="noopener">
          <img
            src="/img/btn-1passo-408.webp"
            srcset="/img/btn-1passo-408.webp 408w, /img/btn-1passo-816.webp 816w"
            sizes="408px"
            alt="Agendar minha sessão pelo WhatsApp"
            width="408"
            height="63"
            loading="lazy"
            decoding="async"
          />
        </a>

        <div class="final-media">
          <img
            src="/img/mesa-576.webp"
            srcset="/img/mesa-576.webp 576w, /img/mesa-1152.webp 1152w"
            sizes="(min-width: 900px) 620px, 92vw"
            alt="Escultura dourada sobre uma mesa de mármore"
            width="576"
            height="467"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </section>

    <!-- ── Contato ────────────────────────────────────────── -->
    <section class="reveal contact" id="contato">
      <div class="wrap contact-grid">
        <div>
          <h2 class="contact-label">Contato</h2>
          <a class="contact-link" href={`mailto:${email}`}>{email}</a>
        </div>
        <div class="contact-right">
          <h2 class="contact-label">WhatsApp</h2>
          <a class="contact-link" href={whatsapp} rel="noopener">
            (11) 99108-5421
          </a>
        </div>
      </div>

      {/* mapa interativo do consultório da Rua Apeninos, em preto e branco */}
      <div class="contact-map">
        <iframe
          title="Mapa — Rua Apeninos, 429, Aclimação, São Paulo"
          src="https://www.google.com/maps/embed?pb=!1m2!2m1!1sR.+Apeninos,+429,+Aclima%C3%A7%C3%A3o,+S%C3%A3o+Paulo,+01533-000"
          width="1024"
          height="440"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          style="border:0"
        ></iframe>
        {/* pin da marca sobreposto no centro (ponto do endereço) */}
        <img
          class="contact-pin"
          src="/img/pin-gmap-40.webp"
          srcset="/img/pin-gmap-40.webp 40w, /img/pin-gmap-80.webp 80w"
          sizes="40px"
          alt=""
          width="40"
          height="54"
          loading="lazy"
          decoding="async"
        />
      </div>

      <ul class="addresses wrap">
        {
          addresses.map((a) => (
            <li>
              <img src="/img/pin.svg" alt="" width="19" height="26" loading="lazy" />
              <a href={a.map} rel="noopener noreferrer" target="_blank">
                {a.text}
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </main>

  <footer class="site-footer">
    <div class="wrap footer-inner">
      <a class="logo" href="#topo" aria-label="Antônia Brandão — topo da página">
        <img src="/img/flourish-gold-177.webp" alt="" width="44" height="55" />
        <img
          class="logo-word"
          src="/img/logo.svg"
          alt="Antônia Brandão"
          width="188"
          height="40"
        />
      </a>

      <nav class="footer-nav" aria-label="Redes sociais">
        {
          social.map((s) => (
            <a href={s.url} rel="noopener noreferrer" target="_blank">
              {s.label}
            </a>
          ))
        }
        <a class="to-top" href="#topo">
          Up
          <svg viewBox="0 0 14 8" aria-hidden="true" focusable="false">
            <path
              d="M1 7l6-6 6 6"
              fill="none"
              stroke="currentColor"
              stroke-width="1.2"></path>
          </svg>
        </a>
      </nav>

      <img
        class="footer-seal"
        src="/img/selo-180.webp"
        srcset="/img/selo-180.webp 180w, /img/selo-360.webp 360w"
        sizes="120px"
        alt="© 2026 — Antônia Brandão · Contato"
        width="180"
        height="178"
        loading="lazy"
        decoding="async"
      />
    </div>
  </footer>
</Layout>

<script>
  // Progressive enhancement: sem JS, tudo aparece normalmente (a classe
  // .js só é adicionada quando há JS). Respeita quem prefere menos movimento.
  const reduz = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const alvos = document.querySelectorAll(".reveal");
  if (reduz || !("IntersectionObserver" in window)) {
    alvos.forEach((el) => el.classList.add("is-visible"));
  } else {
    const io = new IntersectionObserver(
      (entries, obs) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add("is-visible");
            obs.unobserve(e.target);
          }
        }
      },
      { rootMargin: "0px 0px -12% 0px", threshold: 0.1 },
    );
    alvos.forEach((el) => io.observe(el));
  }

  // Menu mobile: fecha ao escolher um item ou apertar Esc.
  const menu = document.querySelector(".menu");
  if (menu) {
    menu.querySelectorAll("nav a").forEach((a) =>
      a.addEventListener("click", () => menu.removeAttribute("open")),
    );
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") menu.removeAttribute("open");
    });
  }
</script>

<style>
  /* ── Animações de entrada ───────────────────────────────── */
  /* :global(.js) porque a classe fica no <html>, fora do escopo do componente */
  :global(.js) .reveal {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.7s ease,
      transform 0.7s ease;
    will-change: opacity, transform;
  }
  :global(.js) .reveal.is-visible {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  /* ── Primitivos ─────────────────────────────────────────── */
  .wrap {
    width: 100%;
    max-width: var(--wrap);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .skip {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    background: #fff;
    padding: 0.75rem 1rem;
  }
  .skip:focus {
    left: 0;
  }

  .eyebrow {
    font-size: clamp(1.125rem, 0.95rem + 0.8vw, 1.625rem);
    line-height: 1.3;
    margin-bottom: 0.75rem;
  }
  .eyebrow :global(em) {
    font-family: var(--font-serif);
    font-size: 1.15em;
  }

  .section-title {
    font-size: var(--step-h2);
  }

  .section-lead {
    font-size: var(--step-lead);
    font-weight: 300;
    line-height: 1.35;
    max-width: 62ch;
    color: var(--c-muted);
  }

  .u {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  /* ── Botões ─────────────────────────────────────────────── */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    border-radius: 999px;
    padding: 0.85em 1.75em;
    font-size: clamp(0.9375rem, 0.85rem + 0.35vw, 1.1875rem);
    letter-spacing: -0.03em;
    line-height: 1.2;
    text-decoration: none;
    transition:
      background-color 0.2s,
      color 0.2s,
      border-color 0.2s;
  }
  /* seta diagonal ↗ (mask para herdar a cor do texto) */
  .btn::after {
    content: "";
    width: 0.62em;
    height: 0.62em;
    flex: none;
    background: currentColor;
    mask: var(--arrow) center / contain no-repeat;
    -webkit-mask: var(--arrow) center / contain no-repeat;
  }
  /* Glass: fundo transparente com blur do que está atrás e borda
     em gradiente (branca no topo, some para baixo) — como no Figma. */
  .btn-glass {
    position: relative;
    color: #fff;
    background: rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(30px) saturate(1.15) brightness(1.06);
    -webkit-backdrop-filter: blur(30px) saturate(1.15) brightness(1.06);
    transition: background-color 0.25s;
  }
  .btn-glass::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(
      to bottom,
      rgba(255, 255, 255, 0.95),
      rgba(255, 255, 255, 0.25) 45%,
      rgba(255, 255, 255, 0.08)
    );
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    pointer-events: none;
  }
  .btn-glass:hover {
    background: rgba(255, 255, 255, 0.16);
  }
  .btn-over {
    position: absolute;
    left: 50%;
    bottom: clamp(1rem, 3vw, 2.5rem);
    transform: translateX(-50%);
    white-space: nowrap;
  }
  .btn-gold {
    color: var(--c-gold);
  }
  .btn-gold::before {
    background: linear-gradient(
      to bottom,
      rgba(181, 142, 74, 0.95),
      rgba(181, 142, 74, 0.3) 45%,
      rgba(181, 142, 74, 0.1)
    );
  }
  .btn-gold :global(em) {
    font-family: var(--font-serif);
    font-size: 1.15em;
