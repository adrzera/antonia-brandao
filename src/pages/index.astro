    img: "service-adolescentes",
    publico: "adolescentes",
    alt: "Adolescentes retratados lado a lado em fundos coloridos",
  },
];

const testimonials = [
  {
    quote:
      "Estava num momento de incertezas e baixa autoestima. A Antônia me ajudou a enxergar tudo de um ângulo diferente. Foi um processo de autoconhecimento, redescobertas e recriação de mim mesma.",
    author: "M. R. — Paciente",
  },
  {
